#!/usr/bin/env bash
# Git post-receive hook for self-hosted deploy.
# Installed into a bare repo on the deploy host. On push to main/master,
# checks out the tree and runs www/ci/pipeline.sh.
set -euo pipefail

DEPLOY_ROOT="${DEPLOY_ROOT:-/home/ken/dev/aula_s98_pro_wireless}"
GIT_DIR="${GIT_DIR:-/home/ken/git/aula_s98_pro_wireless.git}"
BRANCH_RE='refs/heads/(main|master)$'

while read -r oldrev newrev refname; do
  if [[ ! "$refname" =~ $BRANCH_RE ]]; then
    echo "Ignoring $refname (not main/master)"
    continue
  fi

  echo "==== CI/CD triggered by $refname ($oldrev → $newrev) ===="
  mkdir -p "$DEPLOY_ROOT"
  git --git-dir="$GIT_DIR" --work-tree="$DEPLOY_ROOT" checkout -f "${refname#refs/heads/}"

  if [[ ! -x "$DEPLOY_ROOT/www/ci/pipeline.sh" ]]; then
    echo "ERROR: missing $DEPLOY_ROOT/www/ci/pipeline.sh"
    exit 1
  fi

  bash "$DEPLOY_ROOT/www/ci/pipeline.sh" all
  echo "==== CI/CD finished ===="
done
