# Example host nginx reverse-proxy for the Docker-published site.
# Copy to /etc/nginx/sites-available/nitroxstudios.com and enable.
# Requires: DNS A/AAAA for nitroxstudios.com → this host, and TLS (e.g. certbot).

server {
    listen 80;
    listen [::]:80;
    server_name nitroxstudios.com;

    location / {
        proxy_pass http://127.0.0.1:8098;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
